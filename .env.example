# PrivateSight Environment Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Server URL (used by extension)
VITE_SERVER_URL=http://localhost:3001

# Extension Configuration
EXTENSION_SERVER_URL=http://localhost:3001

# Vision Model Configuration (optional - uses mock by default)
# VISION_PROVIDER=onnx
# ONNX_MODEL_PATH=/models/yolov8n-face.onnx
# ONNX_EXECUTION_PROVIDER=webgpu

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Request Timeout (ms)
REQUEST_TIMEOUT_MS=10000

# Maximum Payload Size (bytes)
MAX_PAYLOAD_SIZE=500000

# Logging
LOG_LEVEL=info