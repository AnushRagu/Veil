{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extension",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace=extension",
    "build:extension": "npm run build --workspace=extension",
    "dev:server": "npm run dev --workspace=server",
    "build:server": "npm run build --workspace=server",
    "build:shared": "npm run build --workspace=shared",
    "build": "npm run build:shared && npm run build:extension && npm run build:server",
    "test": "vitest run",
    "lint": "npm run lint --workspaces",
    "demo": "npm run build:extension && npx serve extension/dist",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "core-js@3.29.0": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.2": true
  }
}
